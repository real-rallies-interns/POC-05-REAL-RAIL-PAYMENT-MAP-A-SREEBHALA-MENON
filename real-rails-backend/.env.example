# Real Rails Backend — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=8000
HOST=0.0.0.0
RELOAD=true

# CORS (set to your frontend URL in production)
ALLOWED_ORIGINS=http://localhost:3000

# Optional: World Bank API (no key required — public API)
# WORLD_BANK_API_BASE=https://api.worldbank.org/v2

# Optional: Mapbox token (used by the frontend, not the backend)
# Pass this to the Next.js frontend as NEXT_PUBLIC_MAPBOX_TOKEN
