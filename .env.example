# =============================================================================
# Cinematic Rail PoC — Root Environment File
# Copy this file to .env and fill in your secrets.
# This file is read by docker-compose for BOTH services.
# NEVER commit the real .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend — FastAPI server settings
# ---------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# Set to "false" in production (hot-reload is dev-only)
RELOAD=false

# CORS: set to your actual frontend origin in production
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend — Next.js public runtime variables
# NEXT_PUBLIC_* vars are baked into the JS bundle at build time.
# Changing them requires a rebuild (docker compose up --build).
# ---------------------------------------------------------------------------

# URL the browser will use to reach the backend.
# Inside the Docker network use the service name; from the host use localhost.
# For production, point this at your reverse-proxy / load-balancer URL.
NEXT_PUBLIC_API_URL=http://backend:8000

# Mapbox token — leave blank to fall back to free OpenStreetMap tiles
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiWU9VUl9VU0VSTkFNRSIsImEiOiJZT1VSX1RPS0VOIn0.XXXX
