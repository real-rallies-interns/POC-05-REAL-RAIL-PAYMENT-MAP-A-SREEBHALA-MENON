# Real Rails Frontend — Environment Variables
# Copy to .env.local and configure

# Backend API URL (must match your FastAPI server)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Mapbox GL token for premium tile rendering
# (Free OpenStreetMap tiles are used by default — no token needed)
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoixxxxxx
