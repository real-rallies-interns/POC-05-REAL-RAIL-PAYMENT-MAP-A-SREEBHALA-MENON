r / RTR (Pending)","status":"In Development","maturity":"Emerging","launch_year":null,"operator":"Payments Canada","regulator":"Bank of Canada","transaction_limit_usd":3700,"iso_standard":"ISO 20022","region":"North America","p2p":true,"p2b":false,"b2b":false,"lat":56.1304,"lng":-106.3468,"source":"Payments Canada Modernization Program 2024","description":"Real-Time Rail (RTR) delayed. Interac e-Transfer is near-real-time for P2P only.","data_source":"Payments Canada Public Roadmap + World Bank WDI"},{"country_code":"NG","country_name":"Nigeria","scheme_name":"NIP (NIBSS Instant)","status":"Live","maturity":"Emerging","launch_year":2011,"operator":"Nigeria Inter-Bank Settlement System (NIBSS)","regulator":"Central Bank of Nigeria (CBN)","transaction_limit_usd":1200,"iso_standard":"ISO 8583","region":"Africa","p2p":true,"p2b":true,"b2b":false,"lat":9.082,"lng":8.6753,"source":"NIBSS Industry Statistics 2024; CBN","description":"Nigeria's dominant instant payment scheme. 10B+ transactions annually.","data_source":"NIBSS / CBN Public Data + World Bank WDI"},{"country_code":"KE","country_name":"Kenya","scheme_name":"M-PESA / PesaLink","status":"Live","maturity":"Emerging","launch_year":2007,"operator":"Safaricom / KBA","regulator":"Central Bank of Kenya (CBK)","transaction_limit_usd":1500,"iso_standard":"Proprietary","region":"Africa","p2p":true,"p2b":true,"b2b":false,"lat":-0.0236,"lng":37.9062,"source":"CBK Annual Report 2024; Safaricom Annual Report","description":"M-PESA pioneered mobile money globally. PesaLink links banks to M-PESA.","data_source":"CBK / Safaricom Public Data + World Bank WDI"},{"country_code":"JP","country_name":"Japan","scheme_name":"Zengin System","status":"Live","maturity":"Emerging","launch_year":2018,"operator":"Japanese Bankers Association (JBA)","regulator":"Bank of Japan (BOJ)","transaction_limit_usd":66000,"iso_standard":"Domestic (ISO 20022 migration underway)","region":"Asia-Pacific","p2p":true,"p2b":true,"b2b":true,"lat":36.2048,"lng"